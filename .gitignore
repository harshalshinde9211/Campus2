# ── Dependencies ─────────────────────────────────────────────
node_modules/
backend/node_modules/

# ── Environment files (never commit secrets) ──────────────────
.env
.env.*
backend/.env
backend/.env.*
!.env.example
!backend/.env.example

# ── Build output ──────────────────────────────────────────────
dist/
dist-ssr/

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Markdown / docs (auto-generated, not needed in repo) ──────
*.md
!README.md

# ── OS files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor ───────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?
*.local
